{
  "name": "@twistezo/ai-review-council",
  "version": "1.2.1",
  "description": "Terminal app that runs independent Codex and Claude Code reviewers and merges their results",
  "license": "MIT",
  "keywords": [
    "code-review",
    "ai",
    "claude-code",
    "codex",
    "cli"
  ],
  "homepage": "https://github.com/twistezo/ai-review-council#readme",
  "bugs": "https://github.com/twistezo/ai-review-council/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/twistezo/ai-review-council.git"
  },
  "type": "module",
  "bin": {
    "ai-review-council": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "rm -rf dist && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
